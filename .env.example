BOT_TOKEN=123456:telegram-bot-token
# Публичный адрес сайта привязки (без завершающего /). Для Quick Tunnel без домена оставь пустым:
# бот возьмёт адрес *.trycloudflare.com сам.
PUBLIC_URL=
# Порт веб-сервера привязки
WEB_PORT=8080
# Ключ шифрования логинов/паролей. Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=
# Символ (регион) дневника из URL: https://dziennik-uczen.vulcan.net.pl/<symbol>/
VULCAN_SYMBOL=poznan
# Интервал опроса, секунд
POLL_INTERVAL=300
DB_PATH=vulcanbot.sqlite3

# --- Docker / Cloudflare Tunnel (docker-compose.yml) ---
# Токен именованного туннеля: Cloudflare Zero Trust -> Networks -> Tunnels -> Create -> Docker.
# В туннеле добавь Public hostname: <link.твой-домен> -> http://bot:8765 и поставь тот же адрес в PUBLIC_URL.
TUNNEL_TOKEN=
# Необязательно: исходящий прокси для запросов к Vulcan (скрыть IP сервера), только HTTP(S)-прокси, например http://user:pass@host:3128
# HTTPS_PROXY=
