BOT_TOKEN=123456:telegram-bot-token
# Публичный адрес сайта привязки (без завершающего /)
PUBLIC_URL=https://example.com
# Порт веб-сервера привязки
WEB_PORT=8080
# Ключ шифрования логинов/паролей. Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=
# Символ (регион) дневника из URL: https://dziennik-uczen.vulcan.net.pl/<symbol>/
VULCAN_SYMBOL=poznan
# Интервал опроса, секунд
POLL_INTERVAL=300
DB_PATH=vulcanbot.sqlite3
